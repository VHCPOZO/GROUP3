# --- Docker Compose (local) ---
POSTGRES_DB=arquiteconvencionales
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/arquiteconvencionales
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
SPRING_JPA_HIBERNATE_DDL_AUTO=update
PORT=9090

# --- Railway ---
# 1. Crear servicio PostgreSQL en el mismo proyecto.
# 2. En el servicio de la APP: Variables -> Add Reference -> selecciona PostgreSQL -> DATABASE_URL
#    (recomendado) o DATABASE_PRIVATE_URL para red interna.
# 3. Redeploy. Sin esto la app intenta localhost y falla.
# 4. Usuario admin inicial: admin / admin123
#
# Ejemplo manual en Railway (si no usas referencia):
# SPRING_DATASOURCE_URL=jdbc:postgresql://HOST:PUERTO/railway
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=tu_password
