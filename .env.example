# --- Docker Compose (local) ---
POSTGRES_DB=arquiteconvencionales
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/arquiteconvencionales
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
SPRING_JPA_HIBERNATE_DDL_AUTO=update
PORT=9090

# --- Railway ---
# 1. Crear servicio PostgreSQL y vincularlo al servicio de la app.
# 2. Railway inyecta PGHOST, PGPORT, PGUSER, PGPASSWORD y PGDATABASE automaticamente.
# 3. No hace falta definir SPRING_DATASOURCE_* si PostgreSQL esta vinculado.
# 4. Usuario admin inicial: admin / admin123
